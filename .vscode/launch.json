{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "DAPLink - STM32F103 (OpenOCD)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/SHUIBENG.elf",
            "gdbPath": "C:/Users/33659/AppData/Local/stm32cube/bundles/gnu-tools-for-stm32/14.3.1+st.2/bin/arm-none-eabi-gdb.exe",
            "serverpath": "${input:openocdPath}",
            "configFiles": ["${workspaceFolder}/.vscode/daplink.cfg"],
            "runToEntryPoint": "main",
            "preLaunchTask": "Build Debug for DAPLink"
        }
    ],
    "inputs": [
        {
            "id": "openocdPath",
            "type": "promptString",
            "description": "OpenOCD executable full path (no quotes)",
            "default": "D:/Tools/OpenOCD/bin/openocd.exe"
        }
    ]
}
